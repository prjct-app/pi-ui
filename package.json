{
  "name": "@prjct.app/pi-ui",
  "version": "1.0.0",
  "description": "One Pi interface layer: the startup header, transcript times, compact tool activity, and a focused footer, each switchable with /ui.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "developer-tools",
    "statusline",
    "terminal",
    "tui",
    "transcript",
    "activity-log",
    "tool-calling"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "themes": [
      "./themes/prjct-theme.json"
    ],
    "image": "https://raw.githubusercontent.com/prjct-app/pi-ui/main/docs/cover.png"
  },
  "scripts": {
    "prepublishOnly": "node -e \"if (process.env.GITHUB_ACTIONS !== 'true') { console.error('Publish only from the Release workflow: merge to main.'); process.exit(1); }\"",
    "build": "rm -rf build && mkdir -p build && npm pack --ignore-scripts --pack-destination build >/dev/null && tar -xzf build/*.tgz -C build --strip-components=1 && rm -f build/*.tgz",
    "check": "tsc --noEmit",
    "test": "export PI_CODING_AGENT_DIR=\"$(mktemp -d)\" PRJCT_HOME=\"$(mktemp -d)\" && node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "build:pi": "node scripts/build-pi.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-ui.git"
  },
  "homepage": "https://github.com/prjct-app/pi-ui#readme",
  "bugs": {
    "url": "https://github.com/prjct-app/pi-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "assets",
    "themes",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs/package.md",
    "docs/cover.png"
  ],
  "piBuild": {
    "copy": [
      "themes"
    ]
  },
  "dependencies": {
    "@prjct.app/pi-tui-kit": "^0.3.1",
    "sharp": "^0.35.5"
  }
}
